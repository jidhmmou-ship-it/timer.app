    command_line: "python3 -c \"\nimport urllib.request, re, urllib.parse\nurl = \'https://soundbible.com/tags-splash.html\'\nreq = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0\'})\ntry:\n    with urllib.request.urlopen(req, timeout=5) as res:\n        html = res.read().decode(\'utf-8\', errors=\'ignore\')\n        pages = re.findall(r\'href=[\\\"\\\']([0-9]+-[^\\\"\\\']+\\.html)[\\\"\\\']\', html)\n        print(\'Splash pages:\', pages[:5])\n        for p in pages[:4]:\n            p_url = f\'https://soundbible.com/{p}\'\n            with urllib.request.urlopen(urllib.request.Request(p_url, headers={\'User-Agent\': \'Mozilla/5.0\'}), timeout=5) as p_res:\n                p_html = p_res.read().decode(\'utf-8\', errors=\'ignore\')\n                m = re.search(r\'data-source=\\\"(mp3/[^\\\"]+)\\\"\', p_html)\n                if m:\n                    print(p, \'https://soundbible.com/\' + urllib.parse.quote(m.group(1)))\nexcept Exception as e:\n    print(\'error:\', e)\n\""
