            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const dynamicRadius = `${tl}% ${tr}% ${br}% ${bl}% / ${vtl}% ${vtr}% ${vbr}% ${vbl}%`;"
