            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const tl = Math.round(51 + drop.wobbleX * 6 + breath);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const tr = Math.round(49 - drop.wobbleX * 6 - breath);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const br = Math.round(62 * (1 - bottomProximity * 0.22) + drop.wobbleY * 5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const bl = Math.round(38 * (1 - bottomProximity * 0.18) - drop.wobbleY * 5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const vtl = Math.round(25 + bottomProximity * 12 + drop.wobbleY * 6);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const vtr = Math.round(57 + bottomProximity * 8 - drop.wobbleY * 6);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const vbr = Math.round(43 * (1 - bottomProximity * 0.25) - drop.wobbleX * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const vbl = Math.round(75 * (1 - bottomProximity * 0.2) + drop.wobbleX * 4);"
