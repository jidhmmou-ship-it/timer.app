            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    dropletsRef.current.push(newDrop);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
