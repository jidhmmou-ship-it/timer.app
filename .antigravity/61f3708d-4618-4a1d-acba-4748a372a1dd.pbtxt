              text: "    const rippleY = e.clientY - rect.top;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const newRipple = { id: Date.now(), dropletId: id, x: rippleX, y: rippleY };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    setRipples((prev) => [...prev.slice(-6), newRipple]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const drop = dropletsRef.current.find((d) => d.id === id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (drop) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      drop.wobbleVelY -= 4;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      drop.wobbleVelX += 3;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
