      original_chunk {
        target_content: "      const drops = dropletsRef.current;\n      const pendingRemovals: string[] = [];\n      const bridgePaths: string[] = [];\n\n      // 1. Update individual transitions & single-body kinematics"
        replacement_content: "      const drops = dropletsRef.current;\n      const pendingRemovals: string[] = [];\n      const bridgePaths: string[] = [];\n\n      // Radial burst of tiny, white, semi-transparent splash particles on edge or floor impact\n      const triggerSplash = (\n        originX: number,\n        originY: number,\n        normalX: number,\n        normalY: number,\n        impactSpeed: number,\n        scale: number\n      ) => {\n        const count = Math.min(26, Math.max(9, Math.round(impactSpeed * 0.034 * scale)));\n        const baseAngle = Math.atan2(normalY, normalX);\n\n        for (let i = 0; i < count; i++) {\n          // Radial spray fan oriented along the surface normal (approx 160 degrees)\n          const spread = (Math.random() - 0.5) * Math.PI * 0.88;\n          const angle = baseAngle + spread;\n\n          // Ejection velocity scaled with impact energy\n          const burstSpeed = (0.22 + Math.random() * 0.78) * Math.min(impactSpeed * 0.82, 750);\n          const pVx = Math.cos(angle) * burstSpeed + (Math.random() - 0.5) * 32;\n          const pVy = Math.sin(angle) * burstSpeed + (Math.random() - 0.5) * 32;\n\n          const baseRadius = 1.3 + Math.random() * 2.2 * Math.min(scale, 1.25);\n          const maxLife = 0.28 + Math.random() * 0.22;\n\n          splashParticlesRef.current.push({\n            id: nextSplashIdRef.current++,\n            x: originX + Math.cos(angle) * (Math.random() * 6),\n            y: originY + Math.sin(angle) * (Math.random() * 6),\n            vx: pVx,\n            vy: pVy,\n            initialRadius: baseRadius,\n            currentRadius: baseRadius,\n            initialOpacity: 0.84 + Math.random() * 0.16,\n            currentOpacity: 0.86,\n            life: 0,\n            maxLife,\n          });\n        }\n\n        if (splashParticlesRef.current.length > 120) {\n          splashParticlesRef.current.splice(0, splashParticlesRef.current.length - 120);\n        }\n      };\n\n      // 1. Update individual transitions & single-body kinematics"
        start_line: 308
        end_line: 325
      }
      num_matches: 1
    }
    description: "Add triggerSplash function in RAF loop to spawn radial bursts on edge and floor impact"
    diff_stats {
      additions: 45
    }
  }
}
