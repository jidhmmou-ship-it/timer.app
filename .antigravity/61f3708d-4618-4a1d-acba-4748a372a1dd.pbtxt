              text: "        sp.life += dt / sp.maxLife;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (sp.life >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          splashParticles.splice(s, 1);"
