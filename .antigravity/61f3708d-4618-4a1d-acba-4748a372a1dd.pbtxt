            lines {
              text: "        x: rect.left + rect.width / 2,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        y: rect.top + rect.height / 2,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
