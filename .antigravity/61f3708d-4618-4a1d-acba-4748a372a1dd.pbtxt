              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      animId = requestAnimationFrame(loop);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
