    content: "          state.wobbleVelY -= flingSquash * 3;\n        }\n      }\n    }\n  };\n\n  // Click inside the 1:1 window to create a water ripple\n  const handleWindowClick = (e: React.MouseEvent<HTMLDivElement>) => {\n    const rect = e.currentTarget.getBoundingClientRect();\n    const rippleX = e.clientX - rect.left;\n    const rippleY = e.clientY - rect.top;\n\n    const newRipple = { id: Date.now(), x: rippleX, y: rippleY };\n    setRipples((prev) => [...prev.slice(-3), newRipple]);\n\n    // Soft liquid jiggle on tap\n    stateRef.current.wobbleVelY -= 4;\n    stateRef.current.wobbleVelX += 3;\n\n    setTimeout(() => {\n      setRipples((prev) => prev.filter((r) => r.id !== newRipple.id));\n    }, 900);\n  };\n\n  return (\n    <main className=\"w-screen h-screen min-h-screen bg-white relative overflow-hidden m-0 p-0 select-none\">\n      {/* SVG Liquid Neck / Meniscus (connects taskbar bead and emerging 1:1 window) */}\n      <svg\n        ref={bridgeCanvasRef}\n        className=\"pointer-events-none absolute inset-0 w-full h-full z-10 transition-opacity duration-150\"\n        style={{ opacity: 0 }}\n      >\n        <defs>\n          <linearGradient id=\"waterBridgeGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stopColor=\"rgba(255, 255, 255, 0.9)\" />\n            <stop offset=\"50%\" stopColor=\"rgba(235, 240, 245, 0.45)\" />\n            <stop offset=\"100%\" stopColor=\"rgba(200, 210, 220, 0.6)\" />\n          </linearGradient>\n          <filter id=\"bridgeShadow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feDropShadow dx=\"2\" dy=\"4\" stdDeviation=\"4\" floodColor=\"rgba(0, 0, 0, 0.18)\" />\n          </filter>\n        </defs>\n        <path\n          d=\"\"\n          fill=\"url(#waterBridgeGrad)\"\n          filter=\"url(#bridgeShadow)\"\n          stroke=\"rgba(255, 255, 255, 0.75)\"\n          strokeWidth=\"1.5\"\n        />\n      </svg>\n\n      {/* 1:1 Water Droplet App Window */}\n      <div\n        ref={cardRef}\n        className=\"card\"\n        style={{ display: \'none\' }}\n        onPointerDown={handlePointerDown}\n        onPointerMove={handlePointerMove}\n        onPointerUp={handlePointerUp}\n        onPointerCancel={handlePointerUp}\n        onClick={handleWindowClick}\n      >\n        {/* Minimize bead (merges app back into taskbar) */}\n        <button\n          type=\"button\"\n          aria-label=\"Minimize into taskbar\"\n          className=\"minimize-bead\"\n          onClick={(e) => {\n            e.stopPropagation();\n            dockApp();\n          }}\n          onPointerDown={(e) => e.stopPropagation()}\n        />\n\n        {/* Minimalist 1:1 App Content */}\n        <div className=\"relative z-10 pointer-events-none flex flex-col items-center justify-center gap-1 select-none w-full h-full p-4\">\n          {/* Subtle water droplet icon indicator */}\n          <div className=\"w-4 h-4 rounded-full border border-black/15 flex items-center justify-center opacity-40 mb-1\">\n            <div className=\"w-1.5 h-1.5 rounded-full bg-black/40\" />\n          </div>\n\n          {/* Minimalist 1:1 Clock */}\n          <span className=\"text-xl font-light tracking-widest text-black/55 tabular-nums\">\n            {currentTime || \'12:00\'}\n          </span>\n\n          <span className=\"text-[10px] uppercase tracking-[0.25em] text-black/30 font-medium\">\n            Droplet 1:1\n          </span>\n        </div>\n\n        {/* Dynamic Water Ripples inside the 1:1 window on tap */}\n        {ripples.map((ripple) => (\n          <span\n            key={ripple.id}\n            className=\"pointer-events-none absolute rounded-full border border-black/15 animate-ping opacity-50\"\n            style={{\n              left: ripple.x - 12,\n              top: ripple.y - 12,\n              width: 24,\n              height: 24,\n              animationDuration: \'0.85s\',\n            }}\n          />\n        ))}\n      </div>\n\n      {/* Water Taskbar (Static without wild dynamics, resting at bottom of screen) */}\n      <div className=\"absolute bottom-6 left-1/2 -translate-x-1/2 z-30\">\n        <div className=\"water-taskbar\">\n          {/* Main 1:1 Droplet App Icon in Taskbar */}\n          <div className=\"flex flex-col items-center gap-1\">\n            <button\n              ref={taskbarBeadRef}\n              type=\"button\"\n              aria-label=\"Toggle 1:1 Droplet App\"\n              onClick={launchApp}\n              className=\"taskbar-bead group focus:outline-none\"\n              title=\"Click to extrude 1:1 Droplet App\"\n            >\n              {/* Internal micro water highlight */}\n              <div\n                className={`w-2 h-2 rounded-full transition-all duration-300 ${\n                  appStatus !== \'docked\'\n                    ? \'bg-black/35 scale-110 shadow-sm\'\n                    : \'bg-black/20 group-hover:bg-black/40\'\n                }`}\n              />\n            </button>\n\n            {/* Active app liquid indicator dot */}\n            <div\n              className={`w-1.5 h-1 rounded-full transition-all duration-300 ${\n                appStatus !== \'docked\'\n                  ? \'bg-black/45 w-2.5 opacity-100\'\n                  : \'bg-transparent opacity-0\'\n              }`}\n            />\n          </div>\n\n          {/* Secondary ambient water bead on the taskbar */}\n          <div className=\"flex flex-col items-center gap-1\">\n            <button\n              type=\"button\"\n              aria-label=\"Zen Ripple\"\n              className=\"taskbar-bead-secondary focus:outline-none group\"\n              onClick={() => {\n                if (appStatus === \'floating\') {\n                  stateRef.current.wobbleVelY -= 8;\n                  stateRef.current.wobbleVelX += 6;\n                } else {\n                  launchApp();\n                }\n              }}\n              title=\"Zen ripple\"\n            >\n              <div className=\"w-1.5 h-1.5 rounded-full bg-black/25 group-hover:bg-black/45 transition-colors\" />\n            </button>\n            <div className=\"w-1.5 h-1\" />\n          </div>\n        </div>\n      </div>\n    </main>\n  );\n}\n"
    num_lines: 685
