    }
    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "  // Launch / Extrude the 1:1 droplet app from the taskbar\n  const launchApp = useCallback(() => {\n    updateDockCoords();\n    const state = stateRef.current;\n    if (state.status === \'extruding\' || state.status === \'docking\') return;\n\n    if (state.status === \'floating\') {\n      // If already open, dock it back\n      dockApp();\n      return;\n    }\n\n    // Begin liquid extrusion\n    state.status = \'extruding\';\n    setAppStatus(\'extruding\');\n    state.transStartTime = performance.now();\n    state.transStartX = state.dockX;\n    state.transStartY = state.dockY;\n    state.transTargetX = window.innerWidth / 2;\n    state.transTargetY = Math.max(160, window.innerHeight * 0.42);\n\n    state.x = state.dockX;\n    state.y = state.dockY;\n    state.vx = 0;\n    state.vy = -200;\n    state.wobbleX = 0;\n    state.wobbleY = 0;\n    state.wobbleVelX = 0;\n    state.wobbleVelY = 0;\n  }, [updateDockCoords]);\n\n  // Dock / Absorb the 1:1 droplet app back into the taskbar\n  const dockApp = useCallback(() => {\n    updateDockCoords();\n    const state = stateRef.current;\n    if (state.status === \'docked\' || state.status === \'docking\') return;\n\n    state.status = \'docking\';\n    setAppStatus(\'docking\');\n    state.isDragging = false;\n    state.transStartTime = performance.now();\n    state.transStartX = state.x;\n    state.transStartY = state.y;\n    state.transTargetX = state.dockX;\n    state.transTargetY = state.dockY;\n    state.vx = 0;\n    state.vy = 0;\n  }, [updateDockCoords]);"
        replacement_content: "  // Dock / Absorb the 1:1 droplet app back into the taskbar\n  const dockApp = useCallback(() => {\n    updateDockCoords();\n    const state = stateRef.current;\n    if (state.status === \'docked\' || state.status === \'docking\') return;\n\n    state.status = \'docking\';\n    setAppStatus(\'docking\');\n    state.isDragging = false;\n    state.transStartTime = performance.now();\n    state.transStartX = state.x;\n    state.transStartY = state.y;\n    state.transTargetX = state.dockX;\n    state.transTargetY = state.dockY;\n    state.vx = 0;\n    state.vy = 0;\n  }, [updateDockCoords]);\n\n  // Launch / Extrude the 1:1 droplet app from the taskbar\n  const launchApp = useCallback(() => {\n    updateDockCoords();\n    const state = stateRef.current;\n    if (state.status === \'extruding\' || state.status === \'docking\') return;\n\n    if (state.status === \'floating\') {\n      // If already open, dock it back\n      dockApp();\n      return;\n    }\n\n    // Begin liquid extrusion\n    state.status = \'extruding\';\n    setAppStatus(\'extruding\');\n    state.transStartTime = performance.now();\n    state.transStartX = state.dockX;\n    state.transStartY = state.dockY;\n    state.transTargetX = window.innerWidth / 2;\n    state.transTargetY = Math.max(160, window.innerHeight * 0.42);\n\n    state.x = state.dockX;\n    state.y = state.dockY;\n    state.vx = 0;\n    state.vy = -200;\n    state.wobbleX = 0;\n    state.wobbleY = 0;\n    state.wobbleVelX = 0;\n    state.wobbleVelY = 0;\n  }, [updateDockCoords, dockApp]);"
        start_line: 92
        end_line: 140
      }
      num_matches: 1
    }
    description: "Declare dockApp before launchApp to avoid TDZ in App.tsx"
    diff_stats {
