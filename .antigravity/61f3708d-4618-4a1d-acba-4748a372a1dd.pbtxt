            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Check if dropped near the taskbar: if so, smoothly absorb and dock!"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const distToDock = Math.hypot(state.x - state.dockX, state.y - state.dockY);"
