        target_content: "html,\nbody,\n#root {\n  margin: 0;\n  padding: 0;\n  width: 100%;\n  height: 100%;\n  background-color: #ffffff;\n  overflow: hidden;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\n.card {\n  width: 200px;\n  height: 200px;\n  background-color: transparent;\n  box-shadow: inset 10px 10px 10px 10px rgba(0, 0, 0, 0.158),\n    10px 10px 20px rgba(0, 0, 0, 0.466),\n    inset -10px -10px 10px 10px rgba(255, 255, 255, 0.897);\n  border-radius: 51% 49% 62% 38% / 25% 57% 43% 75%;\n  position: relative;\n  touch-action: none;\n}\n\n.card::after {\n  content: \"\";\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  position: absolute;\n  background-color: rgba(255, 255, 255, 0.842);\n  border-radius: 80% 20% 91% 9% / 48% 67% 33% 52%;\n  top: 40px;\n  left: 40px;\n  pointer-events: none;\n}\n\n.card::before {\n  content: \"\";\n  display: inline-block;\n  width: 20px;\n  height: 20px;\n  position: absolute;\n  background-color: rgba(255, 255, 255, 0.842);\n  border-radius: 48% 52% 45% 55% / 48% 67% 33% 52%;\n  top: 35px;\n  left: 60px;\n  pointer-events: none;\n}"
        replacement_content: "html,\nbody,\n#root {\n  margin: 0;\n  padding: 0;\n  width: 100%;\n  height: 100%;\n  background-color: #ffffff;\n  overflow: hidden;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\n.card {\n  width: 200px;\n  height: 200px;\n  background-color: transparent;\n  box-shadow: inset 10px 10px 10px 10px rgba(0, 0, 0, 0.158),\n    10px 10px 20px rgba(0, 0, 0, 0.466),\n    inset -10px -10px 10px 10px rgba(255, 255, 255, 0.897);\n  border-radius: 51% 49% 62% 38% / 25% 57% 43% 75%;\n  position: absolute;\n  top: 0;\n  left: 0;\n  touch-action: none;\n  cursor: grab;\n  will-change: transform, border-radius;\n  transform-origin: center center;\n}\n\n.card:active {\n  cursor: grabbing;\n}\n\n.card::after {\n  content: \"\";\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  position: absolute;\n  background-color: rgba(255, 255, 255, 0.842);\n  border-radius: 80% 20% 91% 9% / 48% 67% 33% 52%;\n  top: 40px;\n  left: 40px;\n  pointer-events: none;\n}\n\n.card::before {\n  content: \"\";\n  display: inline-block;\n  width: 20px;\n  height: 20px;\n  position: absolute;\n  background-color: rgba(255, 255, 255, 0.842);\n  border-radius: 48% 52% 45% 55% / 48% 67% 33% 52%;\n  top: 35px;\n  left: 60px;\n  pointer-events: none;\n}"
