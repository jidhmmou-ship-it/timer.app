  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useEffect, useRef } from \'react\';\n\ninterface PointerHistory {\n  x: number;\n  y: number;\n  time: number;\n}\n\nexport default function App() {\n  const cardRef = useRef<HTMLDivElement>(null);\n\n  // Simulation physics state in refs for 60-120fps stutter-free RAF updates\n  const stateRef = useRef({\n    // Position of droplet center\n    x: typeof window !== \'undefined\' ? window.innerWidth / 2 : 300,\n    y: typeof window !== \'undefined\' ? window.innerHeight * 0.35 : 200,\n    vx: 0,\n    vy: 120, // initial downward drift\n\n    // Squash & stretch harmonic oscillator (wobble deformation)\n    wobbleX: 0,\n    wobbleY: 0,\n    wobbleVelX: 0,\n    wobbleVelY: 0,\n\n    // Interaction state\n    isDragging: false,\n    dragPointerId: -1,\n    dragOffsetX: 0,\n    dragOffsetY: 0,\n    targetX: 0,\n    targetY: 0,\n    history: [] as PointerHistory[],\n\n    // Animation time\n    lastTime: 0,\n  });\n\n  useEffect(() => {\n    const state = stateRef.current;\n    state.x = window.innerWidth / 2;\n    state.y = window.innerHeight * 0.35;\n    state.targetX = state.x;\n    state.targetY = state.y;\n\n    let animId: number;\n    const R = 90; // Effective radius for boundaries (200px diameter with padding)\n    const GRAVITY = 1100; // px/s\302\262 downward pull\n    const AIR_RESISTANCE = 0.994; // air drag\n    const BOUNCE_RESTITUTION_BOTTOM = 0.42; // liquid settles fast on floor\n    const BOUNCE_RESTITUTION_WALL = 0.68; // bouncy recoil off walls\n    const SPRING_K = 160; // surface tension recovery speed\n    const SPRING_DAMP = 9; // fluid viscosity damping\n\n    const updatePhysics = (timestamp: number) => {\n      if (!state.lastTime) {\n        state.lastTime = timestamp;\n      }\n      // Cap delta time to prevent physics explosions on background tab switch\n      const dt = Math.min((timestamp - state.lastTime) / 1000, 0.033);\n      state.lastTime = timestamp;\n\n      const screenW = window.innerWidth;\n      const screenH = window.innerHeight;\n\n      const minX = R;\n      const maxX = screenW - R;\n      const minY = R;\n      const maxY = screenH - R;\n\n      if (state.isDragging) {\n        // Fluid spring tracking to pointer so droplet feels gelatinous and reactive\n        const followSpeed = 35;\n        const dx = state.targetX - state.x;\n        const dy = state.targetY - state.y;\n\n        state.vx = dx * followSpeed;\n        state.vy = dy * followSpeed;\n\n        state.x += dx * Math.min(1, followSpeed * dt);\n        state.y += dy * Math.min(1, followSpeed * dt);\n\n        // Keep inside bounds while dragging\n        state.x = Math.max(minX, Math.min(maxX, state.x));\n        state.y = Math.max(minY, Math.min(maxY, state.y));\n\n        // Drag stretch in the direction of movement\n        const dragSpeed = Math.hypot(state.vx, state.vy);\n        if (dragSpeed > 100) {\n          const dragStretch = Math.min(dragSpeed * 0.0003, 0.35);\n          const angle = Math.atan2(state.vy, state.vx);\n          state.wobbleX += (Math.cos(angle) * dragStretch - state.wobbleX) * 0.15;\n          state.wobbleY += (Math.sin(angle) * dragStretch - state.wobbleY) * 0.15;\n        }\n      } else {\n        // Free-flying / resting physics\n        state.vy += GRAVITY * dt;\n\n        // Air drag\n        state.vx *= Math.pow(AIR_RESISTANCE, dt * 60);\n        state.vy *= Math.pow(AIR_RESISTANCE, dt * 60);\n\n        state.x += state.vx * dt;\n        state.y += state.vy * dt;\n\n        // Collision with floor (bottom of site)\n        if (state.y >= maxY) {\n          state.y = maxY;\n          const impactSpeed = state.vy;\n\n          if (impactSpeed > 45) {\n            // Squashes wide and flat against the bottom\n            const squashPower = Math.min(impactSpeed * 0.0028, 1.4);\n            state.wobbleVelY -= squashPower * 18;\n            state.wobbleVelX += squashPower * 15;\n            state.vy = -impactSpeed * BOUNCE_RESTITUTION_BOTTOM;\n          } else {\n            state.vy = 0;\n            // Floor friction slows down horizontal sliding\n            state.vx *= Math.pow(0.85, dt * 60);\n            if (Math.abs(state.vx) < 5) state.vx = 0;\n          }\n        }\n\n        // Collision with ceiling\n        if (state.y <= minY) {\n          state.y = minY;\n          const impactSpeed = Math.abs(state.vy);\n          if (impactSpeed > 50) {\n            const squashPower = Math.min(impactSpeed * 0.0025, 1.2);\n            state.wobbleVelY += squashPower * 15;\n            state.wobbleVelX -= squashPower * 12;\n          }\n          state.vy = Math.abs(state.vy) * BOUNCE_RESTITUTION_WALL;\n        }\n\n        // Collision with left wall (recoil)\n        if (state.x <= minX) {\n          state.x = minX;\n          const impactSpeed = Math.abs(state.vx);\n          if (impactSpeed > 40) {\n            const squashPower = Math.min(impactSpeed * 0.003, 1.5);\n            state.wobbleVelX += squashPower * 18; // Compress horizontally\n            state.wobbleVelY -= squashPower * 14; // Bulge vertically\n          }\n          state.vx = Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;\n        }\n\n        // Collision with right wall (recoil)\n        if (state.x >= maxX) {\n          state.x = maxX;\n          const impactSpeed = Math.abs(state.vx);\n          if (impactSpeed > 40) {\n            const squashPower = Math.min(impactSpeed * 0.003, 1.5);\n            state.wobbleVelX -= squashPower * 18; // Compress horizontally\n            state.wobbleVelY -= squashPower * 14; // Bulge vertically\n          }\n          state.vx = -Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;\n        }\n      }\n\n      // Wobble / Recoil spring physics (surface tension recovery)\n      const accX = -SPRING_K * state.wobbleX - SPRING_DAMP * state.wobbleVelX;\n      const accY = -SPRING_K * state.wobbleY - SPRING_DAMP * state.wobbleVelY;\n      state.wobbleVelX += accX * dt;\n      state.wobbleVelY += accY * dt;\n      state.wobbleX += state.wobbleVelX * dt;\n      state.wobbleY += state.wobbleVelY * dt;\n\n      // Bottom proximity for changing shape when resting/dropping at the bottom\n      const bottomDistance = Math.max(0, maxY - state.y);\n      const bottomProximity = Math.max(0, Math.min(1, 1 - bottomDistance / 60));\n\n      // Calculate deformations:\n      // When at the bottom, puddle and flatten outward\n      const puddleFlattenX = bottomProximity * 0.22;\n      const puddleFlattenY = -bottomProximity * 0.18;\n\n      // In-flight elongation along velocity vector when moving fast through the air\n      const speed = Math.hypot(state.vx, state.vy);\n      let flightAngle = 0;\n      let flightStretch = 0;\n      if (!state.isDragging && speed > 100 && bottomProximity < 0.2) {\n        flightAngle = Math.atan2(state.vy, state.vx);\n        flightStretch = Math.min(speed * 0.00032, 0.45);\n      }\n\n      // Effective scales\n      const scaleX = Math.max(0.4, 1 + state.wobbleX + puddleFlattenX);\n      const scaleY = Math.max(0.4, 1 + state.wobbleY + puddleFlattenY);\n\n      // Organic liquid border-radius perturbation:\n      // Changes shape dynamically when resting on the bottom vs flying vs wobbling\n      const t = timestamp * 0.003;\n      const jiggle = Math.sin(t * 3) * 2;\n\n      // Top curvatures stay domed, bottom curvatures flatten against floor when dropped\n      const tl = Math.round(51 + state.wobbleX * 18 + jiggle);\n      const tr = Math.round(49 - state.wobbleX * 18 - jiggle);\n      // As bottomProximity approaches 1, bottom corner radii decrease to flatten out against surface\n      const br = Math.round(62 * (1 - bottomProximity * 0.55) + state.wobbleY * 12);\n      const bl = Math.round(38 * (1 - bottomProximity * 0.45) - state.wobbleY * 12);\n\n      const vtl = Math.round(25 + bottomProximity * 30 + state.wobbleY * 15);\n      const vtr = Math.round(57 + bottomProximity * 15 - state.wobbleY * 15);\n      const vbr = Math.round(43 * (1 - bottomProximity * 0.65) - state.wobbleX * 10);\n      const vbl = Math.round(75 * (1 - bottomProximity * 0.6) + state.wobbleX * 10);\n\n      const dynamicRadius = `${tl}% ${tr}% ${br}% ${bl}% / ${vtl}% ${vtr}% ${vbr}% ${vbl}%`;\n\n      if (cardRef.current) {\n        // Assemble transform:\n        // Center offset: width/height is 200, so anchor is -100px, -100px\n        const tx = state.x - 100;\n        const ty = state.y - 100;\n\n        let transform = `translate3d(${tx}px, ${ty}px, 0)`;\n        if (flightStretch > 0.02) {\n          transform += ` rotate(${flightAngle}rad) scale(${scaleX + flightStretch}, ${scaleY - flightStretch * 0.5}) rotate(${-flightAngle}rad)`;\n        } else {\n          transform += ` scale(${scaleX}, ${scaleY})`;\n        }\n\n        cardRef.current.style.transform = transform;\n        cardRef.current.style.borderRadius = dynamicRadius;\n      }\n\n      animId = requestAnimationFrame(updatePhysics);\n    };\n\n    animId = requestAnimationFrame(updatePhysics);\n\n    const handleResize = () => {\n      const maxX = window.innerWidth - R;\n      const maxY = window.innerHeight - R;\n      state.x = Math.max(R, Math.min(maxX, state.x));\n      state.y = Math.max(R, Math.min(maxY, state.y));\n    };\n\n    window.addEventListener(\'resize\', handleResize);\n\n    return () => {\n      cancelAnimationFrame(animId);\n      window.removeEventListener(\'resize\', handleResize);\n    };\n  }, []);\n\n  const handlePointerDown = (e: React.PointerEvent<HTMLDivElement>) => {\n    const state = stateRef.current;\n    state.isDragging = true;\n    state.dragPointerId = e.pointerId;\n    e.currentTarget.setPointerCapture(e.pointerId);\n\n    // Compute offset from droplet center\n    state.dragOffsetX = e.clientX - state.x;\n    state.dragOffsetY = e.clientY - state.y;\n    state.targetX = e.clientX - state.dragOffsetX;\n    state.targetY = e.clientY - state.dragOffsetY;\n\n    // Reset trajectory history for throwing\n    state.history = [{ x: e.clientX, y: e.clientY, time: performance.now() }];\n\n    // Agitate droplet slightly on pickup\n    state.wobbleVelX += 4;\n    state.wobbleVelY -= 6;\n  };\n\n  const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {\n    const state = stateRef.current;\n    if (!state.isDragging || state.dragPointerId !== e.pointerId) return;\n\n    state.targetX = e.clientX - state.dragOffsetX;\n    state.targetY = e.clientY - state.dragOffsetY;\n\n    const now = performance.now();\n    state.history.push({ x: e.clientX, y: e.clientY, time: now });\n\n    // Keep only last 100ms of history for accurate throw momentum\n    while (state.history.length > 2 && now - state.history[0].time > 100) {\n      state.history.shift();\n    }\n  };\n\n  const handlePointerUp = (e: React.PointerEvent<HTMLDivElement>) => {\n    const state = stateRef.current;\n    if (!state.isDragging || state.dragPointerId !== e.pointerId) return;\n\n    state.isDragging = false;\n    state.dragPointerId = -1;\n\n    try {\n      e.currentTarget.releasePointerCapture(e.pointerId);\n    } catch {\n      // Ignore if capture already lost\n    }\n\n    // Compute fling / throw velocity from recent pointer trail\n    const now = performance.now();\n    const history = state.history.filter((h) => now - h.time <= 120);\n\n    if (history.length >= 2) {\n      const oldest = history[0];\n      const newest = history[history.length - 1];\n      const timeDelta = (newest.time - oldest.time) / 1000;\n\n      if (timeDelta > 0.015) {\n        const throwVx = (newest.x - oldest.x) / timeDelta;\n        const throwVy = (newest.y - oldest.y) / timeDelta;\n\n        // Clamp maximum throw velocity to keep within sane physics bounds\n        const maxSpeed = 3500;\n        const speed = Math.hypot(throwVx, throwVy);\n        if (speed > maxSpeed) {\n          state.vx = (throwVx / speed) * maxSpeed;\n          state.vy = (throwVy / speed) * maxSpeed;\n        } else {\n          state.vx = throwVx;\n          state.vy = throwVy;\n        }\n\n        // Initial agitation on hard throw\n        if (speed > 400) {\n          const flingSquash = Math.min(speed * 0.001, 1.2);\n          state.wobbleVelX += flingSquash * 6;\n          state.wobbleVelY -= flingSquash * 6;\n        }\n      }\n    }\n  };\n\n  // Optional: Clicking anywhere on the empty white surface summons or propels the drop towards the click\n  const handleBackgroundPointerDown = (e: React.PointerEvent<HTMLElement>) => {\n    const state = stateRef.current;\n    if (state.isDragging) return;\n\n    const clickX = e.clientX;\n    const clickY = e.clientY;\n    const dist = Math.hypot(clickX - state.x, clickY - state.y);\n\n    // If clicked within 140px of drop, grab it directly\n    if (dist <= 140) {\n      if (cardRef.current) {\n        handlePointerDown(e as unknown as React.PointerEvent<HTMLDivElement>);\n      }\n      return;\n    }\n\n    // If clicked outside, give the droplet a playful impulse jump towards the click\n    const angle = Math.atan2(clickY - state.y, clickX - state.x);\n    const jumpSpeed = Math.min(dist * 2.8, 1400);\n    state.vx = Math.cos(angle) * jumpSpeed;\n    state.vy = Math.sin(angle) * jumpSpeed - 250; // extra upward arc\n\n    state.wobbleVelX += 8;\n    state.wobbleVelY -= 10;\n  };\n\n  return (\n    <main\n      className=\"w-screen h-screen min-h-screen bg-white relative overflow-hidden m-0 p-0 select-none cursor-default\"\n      onPointerDown={handleBackgroundPointerDown}\n    >\n      <div\n        ref={cardRef}\n        className=\"card\"\n        onPointerDown={(e) => {\n          e.stopPropagation();\n          handlePointerDown(e);\n        }}\n        onPointerMove={handlePointerMove}\n        onPointerUp={handlePointerUp}\n        onPointerCancel={handlePointerUp}\n      />\n    </main>\n  );\n}\n"
