    user_response: "make tis in website in a totally white site without any aditional UI or UHD :\n\nimport React from \'react\';\nimport styled from \'styled-components\';\n\nconst Card = () => {\n  return (\n    <StyledWrapper>\n      <div className=\"card\" />\n    </StyledWrapper>\n  );\n}\n\nconst StyledWrapper = styled.div`\n  .card {\n    width: 200px;\n    height: 200px;\n    background-color: transparent;\n    box-shadow: inset 10px 10px 10px 10px rgba(0, 0, 0, 0.158),\n      10px 10px 20px rgba(0, 0, 0, 0.466),\n      inset -10px -10px 10px 10px rgba(255, 255, 255, 0.897);\n    border-radius: 51% 49% 62% 38% / 25% 57% 43% 75%;\n    position: relative;\n  }\n\n  .card::after {\n    content: \"\";\n    display: inline-block;\n    width: 10px;\n    height: 10px;\n    position: absolute;\n    background-color: rgba(255, 255, 255, 0.842);\n    border-radius: 80% 20% 91% 9% / 48% 67% 33% 52%;\n    top: 40px;\n    left: 40px;\n  }\n\n  .card::before {\n    content: \"\";\n    display: inline-block;\n    width: 20px;\n    height: 20px;\n    position: absolute;\n    background-color: rgba(255, 255, 255, 0.842);\n    border-radius: 48% 52% 45% 55% / 48% 67% 33% 52%;\n    top: 35px;\n    left: 60px;\n  }`;\n\nexport default Card;"
