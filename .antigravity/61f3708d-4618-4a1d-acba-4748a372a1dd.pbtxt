          target_content: ".minimize-bead:hover {\n  transform: scale(1.18);\n}\n"
          replacement_content: ".minimize-bead:hover {\n  transform: scale(1.18);\n}\n\n/* Water surface ripple animation on droplet collision or tap */\n@keyframes waterSurfaceRipple {\n  0% {\n    transform: translate(-50%, -50%) scale(0.18);\n    opacity: 0.82;\n    border-width: 2.5px;\n  }\n  30% {\n    opacity: 0.65;\n  }\n  70% {\n    opacity: 0.35;\n    border-width: 1.5px;\n  }\n  100% {\n    transform: translate(-50%, -50%) scale(5.2);\n    opacity: 0;\n    border-width: 0.5px;\n  }\n}\n\n.water-surface-ripple {\n  position: absolute;\n  border-radius: 50%;\n  pointer-events: none;\n  border-style: solid;\n  border-color: rgba(255, 255, 255, 0.95);\n  box-shadow: 0 0 6px rgba(255, 255, 255, 0.8),\n    inset 0 0 5px rgba(0, 0, 0, 0.1),\n    0 0 3px rgba(0, 0, 0, 0.14);\n  will-change: transform, opacity;\n  animation: waterSurfaceRipple 0.85s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;\n  z-index: 15;\n}\n"
          start_line: 212
          end_line: 215
        }
      }
    }
