            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // In phase 1 (0 to 0.42): droplet stretches upward out of the taskbar with liquid neck"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (progress < 0.42) {"
