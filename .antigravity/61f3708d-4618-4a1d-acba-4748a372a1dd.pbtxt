            lines {
              text: "      if (state.status === \'extruding\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const elapsed = (timestamp - state.transStartTime) / 1000;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const duration = 0.75;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const progress = Math.min(1, elapsed / duration);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Smooth cubic ease out"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const easeOut = 1 - Math.pow(1 - progress, 3);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const easeIn = Math.pow(progress, 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Position interpolation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state.x = state.transStartX + (state.transTargetX - state.transStartX) * easeOut;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state.y = state.transStartY + (state.transTargetY - state.transStartY) * easeOut;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // In phase 1 (0 to 0.4): droplet stretches upward out of the taskbar with liquid neck"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (progress < 0.42) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const stretchPhase = progress / 0.42;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          currentScale = 0.22 + stretchPhase * 0.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Stretches along Y, compresses along X (liquid meniscus pulling free)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.wobbleY = 0.28 * Math.sin(stretchPhase * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.wobbleX = -0.16 * Math.sin(stretchPhase * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Liquid bridge drawing between taskbar bead and emerging drop"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgeOpacity = Math.max(0, 1 - stretchPhase * 0.9);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const neckRadiusDock = 22 * (1 - stretchPhase * 0.4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const neckRadiusDrop = 14 + stretchPhase * 16;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const pinchWidth = Math.max(4, 18 * (1 - stretchPhase * 0.85));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const midY = (state.dockY + state.y) / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgePath = `"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            M ${state.dockX - neckRadiusDock} ${state.dockY}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Q ${state.dockX - pinchWidth} ${midY}, ${state.x - neckRadiusDrop} ${state.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            L ${state.x + neckRadiusDrop} ${state.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Q ${state.dockX + pinchWidth} ${midY}, ${state.dockX + neckRadiusDock} ${state.dockY}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Z"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          `;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Phase 2: Neck has snapped! Droplet blooms smoothly into full 1:1 window"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const bloomPhase = (progress - 0.42) / 0.58;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          currentScale = 0.57 + 0.43 * (1 - Math.pow(1 - bloomPhase, 2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Gentle liquid recoil jiggle upon pinch-off"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.wobbleY = 0.12 * Math.cos(bloomPhase * Math.PI * 3) * (1 - bloomPhase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.wobbleX = -0.08 * Math.cos(bloomPhase * Math.PI * 3) * (1 - bloomPhase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgeOpacity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (progress >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.status = \'floating\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          setAppStatus(\'floating\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.wobbleX = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.wobbleY = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 2. Docking transition (merging back into taskbar)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      else if (state.status === \'docking\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const elapsed = (timestamp - state.transStartTime) / 1000;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const duration = 0.55;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const progress = Math.min(1, elapsed / duration);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const easeIn = Math.pow(progress, 2.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state.x = state.transStartX + (state.transTargetX - state.transStartX) * easeIn;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state.y = state.transStartY + (state.transTargetY - state.transStartY) * easeIn;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Shrinks down towards taskbar bead"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        currentScale = Math.max(0.2, 1 - easeIn * 0.8);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Droplet elongates towards destination"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state.wobbleY = 0.22 * Math.sin(progress * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        state.wobbleX = -0.12 * Math.sin(progress * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Near the end, liquid bridge forms to absorb the drop"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (progress > 0.6) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const absorbPhase = (progress - 0.6) / 0.4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgeOpacity = absorbPhase;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const pinchWidth = 14 * absorbPhase;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const midY = (state.dockY + state.y) / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgePath = `"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            M ${state.dockX - 20} ${state.dockY}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Q ${state.dockX - pinchWidth} ${midY}, ${state.x - 14} ${state.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            L ${state.x + 14} ${state.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Q ${state.dockX + pinchWidth} ${midY}, ${state.dockX + 20} ${state.dockY}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Z"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          `;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (progress >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.status = \'docked\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          setAppStatus(\'docked\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgeOpacity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 3. Floating Interactive State (with calmed, refined deformation & recoil)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      else if (state.status === \'floating\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        currentScale = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (state.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Smooth fluid tracking to pointer"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const followSpeed = 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dx = state.targetX - state.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dy = state.targetY - state.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vx = dx * followSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vy = dy * followSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.x += dx * Math.min(1, followSpeed * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.y += dy * Math.min(1, followSpeed * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Bounds clamp while dragging"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.x = Math.max(minX, Math.min(maxX, state.x));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.y = Math.max(minY, Math.min(maxY, state.y));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Calmed drag stretch: restrained to max 0.12 so it never deforms too much"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dragSpeed = Math.hypot(state.vx, state.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (dragSpeed > 80) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const dragStretch = Math.min(dragSpeed * 0.00012, 0.12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const angle = Math.atan2(state.vy, state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.wobbleX += (Math.cos(angle) * dragStretch - state.wobbleX) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.wobbleY += (Math.sin(angle) * dragStretch - state.wobbleY) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Gravity"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vy += GRAVITY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Air resistance"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vx *= Math.pow(AIR_RESISTANCE, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.vy *= Math.pow(AIR_RESISTANCE, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.x += state.vx * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          state.y += state.vy * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Collision with floor (resting area above taskbar)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (state.y >= maxY) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.y = maxY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const impactSpeed = state.vy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (impactSpeed > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Gentle, refined squash: strictly clamped"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0008, 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelY -= squashPower * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelX += squashPower * 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.vy = -impactSpeed * BOUNCE_RESTITUTION_BOTTOM;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.vy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Ground friction"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.vx *= Math.pow(0.85, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (Math.abs(state.vx) < 3) state.vx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Collision with ceiling"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (state.y <= minY) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.y = minY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const impactSpeed = Math.abs(state.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (impactSpeed > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0008, 0.22);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelY += squashPower * 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelX -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.vy = Math.abs(state.vy) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Collision with left wall (recoil)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (state.x <= minX) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.x = minX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const impactSpeed = Math.abs(state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (impactSpeed > 35) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelX += squashPower * 7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.vx = Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Collision with right wall (recoil)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (state.x >= maxX) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.x = maxX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const impactSpeed = Math.abs(state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (impactSpeed > 35) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelX += squashPower * 7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              state.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            state.vx = -Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Wobble spring damper simulation (strictly clamped)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
