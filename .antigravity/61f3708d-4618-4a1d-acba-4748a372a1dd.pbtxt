            }
            lines {
              text: "            const squashPower = Math.min(impactSpeed * 0.0028, 1.4);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.wobbleVelY -= squashPower * 18;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.wobbleVelX += squashPower * 15;"
