        target_content: "          // Collision with floor (resting area above taskbar)\n          if (state.y >= maxY) {\n            state.y = maxY;\n            const impactSpeed = state.vy;\n\n            if (impactSpeed > 40) {\n              // Gentle, refined squash: strictly clamped\n              const squashPower = Math.min(impactSpeed * 0.0008, 0.25);\n              state.wobbleVelY -= squashPower * 8;\n              state.wobbleVelX += squashPower * 6;\n              state.vy = -impactSpeed * BOUNCE_RESTITUTION_BOTTOM;\n            } else {\n              state.vy = 0;\n              // Ground friction\n              state.vx *= Math.pow(0.85, dt * 60);\n              if (Math.abs(state.vx) < 3) state.vx = 0;\n            }\n          }\n\n          // Collision with ceiling\n          if (state.y <= minY) {\n            state.y = minY;\n            const impactSpeed = Math.abs(state.vy);\n            if (impactSpeed > 40) {\n              const squashPower = Math.min(impactSpeed * 0.0008, 0.22);\n              state.wobbleVelY += squashPower * 6;\n              state.wobbleVelX -= squashPower * 5;\n            }\n            state.vy = Math.abs(state.vy) * BOUNCE_RESTITUTION_WALL;\n          }\n\n          // Collision with left wall (recoil)\n          if (state.x <= minX) {\n            state.x = minX;\n            const impactSpeed = Math.abs(state.vx);\n            if (impactSpeed > 35) {\n              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);\n              state.wobbleVelX += squashPower * 7;\n              state.wobbleVelY -= squashPower * 5;\n            }\n            state.vx = Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;\n          }\n\n          // Collision with right wall (recoil)\n          if (state.x >= maxX) {\n            state.x = maxX;\n            const impactSpeed = Math.abs(state.vx);\n            if (impactSpeed > 35) {\n              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);\n              state.wobbleVelX += squashPower * 7;\n              state.wobbleVelY -= squashPower * 5;\n            }\n            state.vx = -Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;\n          }"
        replacement_content: "          // Collision with floor (resting area above taskbar)\n          if (state.y >= maxY) {\n            state.y = maxY;\n            const impactSpeed = state.vy;\n\n            if (impactSpeed > 40) {\n              playImpactSound(impactSpeed, \'bottom\');\n              // Gentle, refined squash: strictly clamped\n              const squashPower = Math.min(impactSpeed * 0.0008, 0.25);\n              state.wobbleVelY -= squashPower * 8;\n              state.wobbleVelX += squashPower * 6;\n              state.vy = -impactSpeed * BOUNCE_RESTITUTION_BOTTOM;\n            } else {\n              state.vy = 0;\n              // Ground friction\n              state.vx *= Math.pow(0.85, dt * 60);\n              if (Math.abs(state.vx) < 3) state.vx = 0;\n            }\n          }\n\n          // Collision with ceiling\n          if (state.y <= minY) {\n            state.y = minY;\n            const impactSpeed = Math.abs(state.vy);\n            if (impactSpeed > 40) {\n              playImpactSound(impactSpeed, \'wall\');\n              const squashPower = Math.min(impactSpeed * 0.0008, 0.22);\n              state.wobbleVelY += squashPower * 6;\n              state.wobbleVelX -= squashPower * 5;\n            }\n            state.vy = Math.abs(state.vy) * BOUNCE_RESTITUTION_WALL;\n          }\n\n          // Collision with left wall (recoil)\n          if (state.x <= minX) {\n            state.x = minX;\n            const impactSpeed = Math.abs(state.vx);\n            if (impactSpeed > 35) {\n              playImpactSound(impactSpeed, \'wall\');\n              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);\n              state.wobbleVelX += squashPower * 7;\n              state.wobbleVelY -= squashPower * 5;\n            }\n            state.vx = Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;\n          }\n\n          // Collision with right wall (recoil)\n          if (state.x >= maxX) {\n            state.x = maxX;\n         