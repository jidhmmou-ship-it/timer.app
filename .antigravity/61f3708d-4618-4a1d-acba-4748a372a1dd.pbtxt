            }
            lines {
              text: "        const dragSpeed = Math.hypot(state.vx, state.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (dragSpeed > 100) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dragStretch = Math.min(dragSpeed * 0.0003, 0.35);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const angle = Math.atan2(state.vy, state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.wobbleX += (Math.cos(angle) * dragStretch - state.wobbleX) * 0.15;"
