            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const t = timestamp * 0.002 + drop.index;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const breath = Math.sin(t * 2) * 1.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const tl = Math.round(51 + drop.wobbleX * 6 + breath);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const tr = Math.round(49 - drop.wobbleX * 6 - breath);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
