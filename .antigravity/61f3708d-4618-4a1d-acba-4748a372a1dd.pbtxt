+ 10;\n      const maxX = screenW - R - 10;\n      const minY = R + 10;\n      const maxY = Math.min(screenH - R - 10, taskbarTop - 15);\n\n      let currentScale = 1;\n      let bridgeOpacity = 0;\n      let bridgePath = \'\';\n\n      // 1. Extruding transition (budding from taskbar)\n      if (state.status === \'extruding\') {\n        const elapsed = (timestamp - state.transStartTime) / 1000;\n        const duration = 0.75;\n        const progress = Math.min(1, elapsed / duration);\n\n        // Smooth cubic ease out\n        const easeOut = 1 - Math.pow(1 - progress, 3);\n        const easeIn = Math.pow(progress, 2);\n\n        // Position interpolation\n        state.x = state.transStartX + (state.transTargetX - state.transStartX) * easeOut;\n        state.y = state.transStartY + (state.transTargetY - state.transStartY) * easeOut;\n\n        // In phase 1 (0 to 0.4): droplet stretches upward out of the taskbar with liquid neck\n        if (progress < 0.42) {\n          const stretchPhase = progress / 0.42;\n          currentScale = 0.22 + stretchPhase * 0.35;\n          // Stretches along Y, compresses along X (liquid meniscus pulling free)\n          state.wobbleY = 0.28 * Math.sin(stretchPhase * Math.PI);\n          state.wobbleX = -0.16 * Math.sin(stretchPhase * Math.PI);\n\n          // Liquid bridge drawing between taskbar bead and emerging drop\n          bridgeOpacity = Math.max(0, 1 - stretchPhase * 0.9);\n          const neckRadiusDock = 22 * (1 - stretchPhase * 0.4);\n          const neckRadiusDrop = 14 + stretchPhase * 16;\n          const pinchWidth = Math.max(4, 18 * (1 - stretchPhase * 0.85));\n\n          const midY = (state.dockY + state.y) / 2;\n          bridgePath = `\n            M ${state.dockX - neckRadiusDock} ${state.dockY}\n            Q ${state.dockX - pinchWidth} ${midY}, ${state.x - neckRadiusDrop} ${state.y}\n            L ${state.x + neckRadiusDrop} ${state.y}\n            Q ${state.dockX + pinchWidth} ${midY}, ${state.dockX + neckRadiusDock} ${state.dockY}\n            Z\n          `;\n        } else {\n          // Phase 2: Neck has snapped! Droplet blooms smoothly into full 1:1 window\n          const bloomPhase = (progress - 0.42) / 0.58;\n          currentScale = 0.57 + 0.43 * (1 - Math.pow(1 - bloomPhase, 2));\n\n          // Gentle liquid recoil jiggle upon pinch-off\n          state.wobbleY = 0.12 * Math.cos(bloomPhase * Math.PI * 3) * (1 - bloomPhase);\n          state.wobbleX = -0.08 * Math.cos(bloomPhase * Math.PI * 3) * (1 - bloomPhase);\n          bridgeOpacity = 0;\n        }\n\n        if (progress >= 1) {\n          state.status = \'floating\';\n          setAppStatus(\'floating\');\n          state.vx = 0;\n          state.vy = 0;\n          state.wobbleX = 0;\n          state.wobbleY = 0;\n        }\n      }\n\n      // 2. Docking transition (merging back into taskbar)\n      else if (state.status === \'docking\') {\n        const elapsed = (timestamp - state.transStartTime) / 1000;\n        const duration = 0.55;\n        const progress = Math.min(1, elapsed / duration);\n\n        const easeIn = Math.pow(progress, 2.5);\n        state.x = state.transStartX + (state.transTargetX - state.transStartX) * easeIn;\n        state.y = state.transStartY + (state.transTargetY - state.transStartY) * easeIn;\n\n        // Shrinks down towards taskbar bead\n        currentScale = Math.max(0.2, 1 - easeIn * 0.8);\n\n        // Droplet elongates towards destination\n        state.wobbleY = 0.22 * Math.sin(progress * Math.PI);\n        state.wobbleX = -0.12 * Math.sin(progress * Math.PI);\n\n        // Near the end, liquid bridge forms to absorb the drop\n        if (progress > 0.6) {\n          const absorbPhase = (progress - 0.6) / 0.4;\n          bridgeOpacity = absorbPhase;\n          const pinchWidth = 14 * absorbPhase;\n          const midY = (state.dockY + state.y) / 2;\n          bridgePath = `\n            M ${state.dockX - 20} ${state.dockY}\n            Q ${state.dockX - pinch