            }
            lines {
              text: "          cardElementsRef.current.delete(id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        setDropletList("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          dropletsRef.current.map((d) => ({"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            id: d.id,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
