            lines {
              text: "              drop.wobbleX += (Math.cos(angle) * dragStretch - drop.wobbleX) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              drop.wobbleY += (Math.sin(angle) * dragStretch - drop.wobbleY) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            drop.vy += GRAVITY * dt;"
