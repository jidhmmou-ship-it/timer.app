            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Free-flying / resting physics"
