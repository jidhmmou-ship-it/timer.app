    end_line: 221
    content: "    const count = dropletsRef.current.filter((d) => d.status !== \'merged_out\').length;\n    const offsetSlot = (count % 4) - 1.5;\n    const spreadX = offsetSlot * 160 + (Math.random() - 0.5) * 60;\n    const targetX = Math.max(130, Math.min(screenW - 130, screenW / 2 + spreadX));\n    const targetY = Math.max(150, screenH * 0.38 + (Math.random() - 0.5) * 80);\n\n    topZRef.current += 1;\n\n    const newDrop: DropletState = {\n      id: newId,\n      index: newIndex,\n      x: dock.x,\n      y: dock.y,\n      vx: (Math.random() - 0.5) * 80,\n      vy: -240,\n      scale: 0.22,\n      targetScale: 1.0,\n      baseRadius: 100,\n      mass: 1.0,\n      merges: 1,\n      wobbleX: 0,\n      wobbleY: 0,\n      wobbleVelX: 0,\n      wobbleVelY: 0,\n      status: \'extruding\',\n      transStartTime: performance.now(),\n      transStartX: dock.x,\n      transStartY: dock.y,\n      transTargetX: targetX,\n      transTargetY: targetY,\n      hasSnapped: false,\n      isDragging: false,\n      dragPointerId: -1,\n      dragOffsetX: 0,\n      dragOffsetY: 0,\n      targetX: dock.x,\n      targetY: dock.y,\n      history: [],\n      zIndex: topZRef.current,\n      lastVaporTime: 0,\n    };\n\n    dropletsRef.current.push(newDrop);"
