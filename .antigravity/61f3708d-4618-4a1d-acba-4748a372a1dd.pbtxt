            }
            lines {
              text: "          const impactSpeed = state.vy;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (impactSpeed > 45) {"
