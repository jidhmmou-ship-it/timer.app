            }
            lines {
              text: "            L ${state.x + 14} ${state.y}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            Q ${state.dockX + pinchWidth} ${midY}, ${state.dockX + 20} ${state.dockY}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            Z"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          `;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (progress >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.status = \'docked\';"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          setAppStatus(\'docked\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          bridgeOpacity = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          playMergeSound();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // 3. Floating Interactive State (with calmed, refined deformation & recoil)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      else if (state.status === \'floating\') {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        currentScale = 1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (state.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Smooth fluid tracking to pointer"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const followSpeed = 30;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dx = state.targetX - state.x;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dy = state.targetY - state.y;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.vx = dx * followSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.vy = dy * followSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.x += dx * Math.min(1, followSpeed * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.y += dy * Math.min(1, followSpeed * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Bounds clamp while dragging"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.x = Math.max(minX, Math.min(maxX, state.x));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.y = Math.max(minY, Math.min(maxY, state.y));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Calmed drag stretch: restrained to max 0.12 so it never deforms too much"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dragSpeed = Math.hypot(state.vx, state.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (dragSpeed > 80) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const dragStretch = Math.min(dragSpeed * 0.00012, 0.12);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const angle = Math.atan2(state.vy, state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.wobbleX += (Math.cos(angle) * dragStretch - state.wobbleX) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.wobbleY += (Math.sin(angle) * dragStretch - state.wobbleY) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Gravity"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.vy += GRAVITY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Air resistance"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.vx *= Math.pow(AIR_RESISTANCE, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.vy *= Math.pow(AIR_RESISTANCE, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.x += state.vx * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.y += state.vy * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Collision with floor (resting area above taskbar)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (state.y >= maxY) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.y = maxY;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const impactSpeed = state.vy;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            if (impactSpeed > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              playImpactSound(impactSpeed, \'bottom\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              // Gentle, refined squash: strictly clamped"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0008, 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelY -= squashPower * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelX += squashPower * 6;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.vy = -impactSpeed * BOUNCE_RESTITUTION_BOTTOM;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.vy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              // Ground friction"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.vx *= Math.pow(0.85, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              if (Math.abs(state.vx) < 3) state.vx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Collision with ceiling"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (state.y <= minY) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.y = minY;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const impactSpeed = Math.abs(state.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            if (impactSpeed > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              playImpactSound(impactSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0008, 0.22);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelY += squashPower * 6;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelX -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.vy = Math.abs(state.vy) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Collision with left wall (recoil)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (state.x <= minX) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.x = minX;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const impactSpeed = Math.abs(state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            if (impactSpeed > 35) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              playImpactSound(impactSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelX += squashPower * 7;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.vx = Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Collision with right wall (recoil)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (state.x >= maxX) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.x = maxX;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const impactSpeed = Math.abs(state.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            if (impactSpeed > 35) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              playImpactSound(impactSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              const squashPower = Math.min(impactSpeed * 0.0009, 0.24);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelX += squashPower * 7;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "              state.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            state.vx = -Math.abs(state.vx) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Wobble spring damper simulation (strictly clamped)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const accX = -SPRING_K * state.wobbleX - SPRING_DAMP * state.wobbleVelX;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const accY = -SPRING_K * state.wobbleY - SPRING_DAMP * state.wobbleVelY;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        state.wobbleVelX += accX * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        state.wobbleVelY += accY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        state.wobbleX += state.wobbleVelX * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        state.wobbleY += state.wobbleVelY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Hard clamp wobble displacement so it NEVER over-deforms!"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        state.wobbleX = Math.max(-0.14, Math.min(0.14, state.wobbleX));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        state.wobbleY = Math.max(-0.14, Math.min(0.14, state.wobbleY));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Render bridge canvas if extruding or docking"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      if (bridgeCanvasRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const pathEl = bridgeCanvasRef.current.querySelector(\'path\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const dock = dockCoordsRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const taskbarTop = dock.y - 35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const drops = dropletsRef.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pendingRemovals: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const bridgePaths: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 1. Update individual transitions & single-body kinematics"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (const drop of drops) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (drop.status === \'merged_out\') continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const effectiveRadius = drop.baseRadius * drop.scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const minX = effectiveRadius + 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const maxX = screenW - effectiveRadius - 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const minY = effectiveRadius + 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const maxY = Math.min(screenH - effectiveRadius - 8, taskbarTop - 12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Smooth scale interpolation (e.g. after merging or budding)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        drop.scale += (drop.targetScale - drop.scale) * Math.min(1, 10 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // A. Extruding transition"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (drop.status === \'extruding\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const elapsed = (timestamp - drop.transStartTime) / 1000;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const duration = 0.72;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const progress = Math.min(1, elapsed / duration);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const easeOut = 1 - Math.pow(1 - progress, 3);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.x = drop.transStartX + (drop.transTargetX - drop.transStartX) * easeOut;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.y = drop.transStartY + (drop.transTargetY - drop.transStartY) * easeOut;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (progress < 0.42) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const stretchPhase = progress / 0.42;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.scale = 0.22 + stretchPhase * 0.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.wobbleY = 0.26 * Math.sin(stretchPhase * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.wobbleX = -0.15 * Math.sin(stretchPhase * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Draw liquid bridge connecting taskbar to this extruding drop"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const neckRadiusDock = 22 * (1 - stretchPhase * 0.4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const neckRadiusDrop = 14 + stretchPhase * 16;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const pinchWidth = Math.max(3, 18 * (1 - stretchPhase * 0.85));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const midY = (dock.y + drop.y) / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            bridgePaths.push(`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              M ${dock.x - neckRadiusDock} ${dock.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Q ${dock.x - pinchWidth} ${midY}, ${drop.x - neckRadiusDrop} ${drop.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              L ${drop.x + neckRadiusDrop} ${drop.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Q ${dock.x + pinchWidth} ${midY}, ${dock.x + neckRadiusDock} ${dock.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Z"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            `);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (!drop.hasSnapped) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.hasSnapped = true;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              playNeckSnapSound();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const bloomPhase = (progress - 0.42) / 0.58;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.scale = 0.57 + (drop.targetScale - 0.57) * (1 - Math.pow(1 - bloomPhase, 2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.wobbleY = 0.12 * Math.cos(bloomPhase * Math.PI * 3) * (1 - bloomPhase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.wobbleX = -0.08 * Math.cos(bloomPhase * Math.PI * 3) * (1 - bloomPhase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (progress >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.status = \'floating\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.wobbleX = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.wobbleY = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // B. Docking transition"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        else if (drop.status === \'docking\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const elapsed = (timestamp - drop.transStartTime) / 1000;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const duration = 0.52;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const progress = Math.min(1, elapsed / duration);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const easeIn = Math.pow(progress, 2.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.x = drop.transStartX + (drop.transTargetX - drop.transStartX) * easeIn;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.y = drop.transStartY + (drop.transTargetY - drop.transStartY) * easeIn;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.scale = Math.max(0.18, drop.targetScale * (1 - easeIn * 0.82));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleY = 0.22 * Math.sin(progress * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleX = -0.12 * Math.sin(progress * Math.PI);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (progress > 0.55) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const absorbPhase = (progress - 0.55) / 0.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const pinchWidth = 14 * absorbPhase;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const midY = (dock.y + drop.y) / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            bridgePaths.push(`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              M ${dock.x - 20} ${dock.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Q ${dock.x - pinchWidth} ${midY}, ${drop.x - 14} ${drop.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              L ${drop.x + 14} ${drop.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Q ${dock.x + pinchWidth} ${midY}, ${dock.x + 20} ${dock.y}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Z"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            `);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (progress >= 1) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.status = \'merged_out\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            pendingRemovals.push(drop.id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            playMergeSound();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // C. Free floating physics"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        else if (drop.status === \'floating\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (drop.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const followSpeed = 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const dx = drop.targetX - drop.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const dy = drop.targetY - drop.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vx = dx * followSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vy = dy * followSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.x += dx * Math.min(1, followSpeed * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.y += dy * Math.min(1, followSpeed * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.x = Math.max(minX, Math.min(maxX, drop.x));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.y = Math.max(minY, Math.min(maxY, drop.y));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const dragSpeed = Math.hypot(drop.vx, drop.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (dragSpeed > 80) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const dragStretch = Math.min(dragSpeed * 0.00012, 0.12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const angle = Math.atan2(drop.vy, drop.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.wobbleX += (Math.cos(angle) * dragStretch - drop.wobbleX) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.wobbleY += (Math.sin(angle) * dragStretch - drop.wobbleY) * 0.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vy += GRAVITY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vx *= Math.pow(AIR_RESISTANCE, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.vy *= Math.pow(AIR_RESISTANCE, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.x += drop.vx * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            drop.y += drop.vy * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Floor collision"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (drop.y >= maxY) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.y = maxY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const impactSpeed = drop.vy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (impactSpeed > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                playImpactSound(impactSpeed, \'bottom\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const squashPower = Math.min(impactSpeed * 0.0008, 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelY -= squashPower * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelX += squashPower * 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.vy = -impactSpeed * BOUNCE_RESTITUTION_BOTTOM;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.vy = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.vx *= Math.pow(0.85, dt * 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                if (Math.abs(drop.vx) < 3) drop.vx = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Ceiling collision"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (drop.y <= minY) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.y = minY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const impactSpeed = Math.abs(drop.vy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (impactSpeed > 40) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                playImpactSound(impactSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const squashPower = Math.min(impactSpeed * 0.0008, 0.22);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelY += squashPower * 6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelX -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.vy = Math.abs(drop.vy) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Left wall collision"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (drop.x <= minX) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.x = minX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const impactSpeed = Math.abs(drop.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (impactSpeed > 35) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                playImpactSound(impactSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const squashPower = Math.min(impactSpeed * 0.0009, 0.24);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelX += squashPower * 7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.vx = Math.abs(drop.vx) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Right wall collision"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (drop.x >= maxX) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.x = maxX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const impactSpeed = Math.abs(drop.vx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (impactSpeed > 35) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                playImpactSound(impactSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                const squashPower = Math.min(impactSpeed * 0.0009, 0.24);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelX += squashPower * 7;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                drop.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              drop.vx = -Math.abs(drop.vx) * BOUNCE_RESTITUTION_WALL;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Harmonic wobble spring simulation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const accX = -SPRING_K * drop.wobbleX - SPRING_DAMP * drop.wobbleVelX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const accY = -SPRING_K * drop.wobbleY - SPRING_DAMP * drop.wobbleVelY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleVelX += accX * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleVelY += accY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleX += drop.wobbleVelX * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleY += drop.wobbleVelY * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleX = Math.max(-0.14, Math.min(0.14, drop.wobbleX));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          drop.wobbleY = Math.max(-0.14, Math.min(0.14, drop.wobbleY));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 2. Inter-Droplet Collision Detection & Resolution (Bounce vs Merge)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const floatingDrops = drops.filter((d) => d.status === \'floating\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const numFloating = floatingDrops.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < numFloating; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const dropA = floatingDrops[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (dropA.status === \'merged_out\') continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (let j = i + 1; j < numFloating; j++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dropB = floatingDrops[j];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (dropB.status === \'merged_out\') continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dx = dropB.x - dropA.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dy = dropB.y - dropA.y;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dist = Math.hypot(dx, dy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const rA = dropA.baseRadius * dropA.scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const rB = dropB.baseRadius * dropB.scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const minDist = (rA + rB) * 0.96;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (dist < minDist && dist > 0.001) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const nx = dx / dist;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const ny = dy / dist;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const relVx = dropB.vx - dropA.vx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const relVy = dropB.vy - dropA.vy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const relSpeed = Math.hypot(relVx, relVy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const velAlongNormal = relVx * nx + relVy * ny;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Merge condition: gentle relative velocity or one dragged onto the other"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const isDraggingEither = dropA.isDragging || dropB.isDragging;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const shouldMerge ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              (relSpeed < 280 && dist < minDist * 0.88) ||"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              (isDraggingEither && dist < minDist * 0.72);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (shouldMerge) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // MERGE: Surface-tension coalescence!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              playMergeSound();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Dominant droplet absorbs the other"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const dominant = dropB.isDragging ? dropB : dropA;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const absorbed = dominant === dropA ? dropB : dropA;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const totalMass = dominant.mass + absorbed.mass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.x = (dominant.x * dominant.mass + absorbed.x * absorbed.mass) / totalMass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.y = (dominant.y * dominant.mass + absorbed.y * absorbed.mass) / totalMass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.vx = (dominant.vx * dominant.mass + absorbed.vx * absorbed.mass) / totalMass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.vy = (dominant.vy * dominant.mass + absorbed.vy * absorbed.mass) / totalMass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.mass = totalMass;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.merges += absorbed.merges;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Expand scale gently (surface area conservation)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.targetScale = Math.min(1.42, Math.sqrt(dominant.scale ** 2 + absorbed.scale ** 2 * 0.8));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // Fluid jiggle agitation upon coalescence"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.wobbleVelY -= 12;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dominant.wobbleVelX += 9;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              absorbed.status = \'merged_out\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              pendingRemovals.push(absorbed.id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            } else if (velAlongNormal < 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              // BOUNCE: High-velocity elastic liquid rebound"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const overlap = (minDist - dist) * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (!dropA.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropA.x -= nx * overlap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropA.y -= ny * overlap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (!dropB.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropB.x += nx * overlap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropB.y += ny * overlap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const RESTITUTION = 0.55;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const impulse ="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                (-(1 + RESTITUTION) * velAlongNormal) /"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                (1 / dropA.mass + 1 / dropB.mass);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (!dropA.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropA.vx -= (impulse / dropA.mass) * nx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropA.vy -= (impulse / dropA.mass) * ny;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (!dropB.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropB.vx += (impulse / dropB.mass) * nx;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                dropB.vy += (impulse / dropB.mass) * ny;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              playImpactSound(relSpeed, \'wall\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const squash = Math.min(relSpeed * 0.0006, 0.18);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dropA.wobbleVelX += (Math.abs(ny) - Math.abs(nx)) * squash * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dropA.wobbleVelY += (Math.abs(nx) - Math.abs(ny)) * squash * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dropB.wobbleVelX += (Math.abs(ny) - Math.abs(nx)) * squash * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              dropB.wobbleVelY += (Math.abs(nx) - Math.abs(ny)) * squash * 8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 3. Render SVG liquid bridges"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (bridgeSvgRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const pathEl = bridgeSvgRef.current.querySelector(\'path\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (pathEl) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          pathEl.setAttribute(\'d\', bridgePath);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          bridgeCanvasRef.current.style.opacity = bridgeOpacity.toString();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Render 1:1 Window"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      if (cardRef.current) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (state.status === \'docked\') {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          cardRef.current.style.display = \'none\';"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        } else {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          cardRef.current.style.display = \'flex\';"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Controlled scale: clamp strictly between 0.86 and 1.18"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const bottomDistance = Math.max(0, maxY - state.y);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const bottomProximity = Math.max(0, Math.min(1, 1 - bottomDistance / 50));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const bottomFlattenX = bottomProximity * 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const bottomFlattenY = -bottomProximity * 0.06;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const rawScaleX = (1 + state.wobbleX + bottomFlattenX) * currentScale;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const rawScaleY = (1 + state.wobbleY + bottomFlattenY) * currentScale;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const finalScaleX = Math.max(0.18, Math.min(1.2, rawScaleX));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const finalScaleY = Math.max(0.18, Math.min(1.2, rawScaleY));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Center offset: width/height is 220, anchor is -110px, -110px"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const tx = state.x - 110;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const ty = state.y - 110;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          cardRef.current.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${finalScaleX}, ${finalScaleY})`;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Restrained organic border-radius: variations kept strictly within \302\2615%"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // so it always maintains its clean water drop shape without turning weird"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const t = timestamp * 0.002;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const breath = Math.sin(t * 2) * 1.5;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const tl = Math.round(51 + state.wobbleX * 6 + breath);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const tr = Math.round(49 - state.wobbleX * 6 - breath);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const br = Math.round(62 * (1 - bottomProximity * 0.22) + state.wobbleY * 5);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const bl = Math.round(38 * (1 - bottomProximity * 0.18) - state.wobbleY * 5);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const vtl = Math.round(25 + bottomProximity * 12 + state.wobbleY * 6);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const vtr = Math.round(57 + bottomProximity * 8 - state.wobbleY * 6);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const vbr = Math.round(43 * (1 - bottomProximity * 0.25) - state.wobbleX * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const vbl = Math.round(75 * (1 - bottomProximity * 0.2) + state.wobbleX * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          cardRef.current.style.borderRadius = `${tl}% ${tr}% ${br}% ${bl}% / ${vtl}% ${vtr}% ${vbr}% ${vbl}%`;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          pathEl.setAttribute(\'d\', bridgePaths.join(\' \'));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          bridgeSvgRef.current.style.opacity = bridgePaths.length > 0 ? \'1\' : \'0\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 4. Update DOM styling for each active droplet window"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (const drop of drops) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (drop.status === \'merged_out\') continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const el = cardElementsRef.current.get(drop.id);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!el) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const effectiveRadius = drop.baseRadius * drop.scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const maxY = Math.min(screenH - effectiveRadius - 8, taskbarTop - 12);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bottomDistance = Math.max(0, maxY - drop.y);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bottomProximity = Math.max(0, Math.min(1, 1 - bottomDistance / 50));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bottomFlattenX = bottomProximity * 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bottomFlattenY = -bottomProximity * 0.06;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const rawScaleX = (1 + drop.wobbleX + bottomFlattenX) * drop.scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const rawScaleY = (1 + drop.wobbleY + bottomFlattenY) * drop.scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const finalScaleX = Math.max(0.18, Math.min(1.5, rawScaleX));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const finalScaleY = Math.max(0.18, Math.min(1.5, rawScaleY));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const tx = drop.x - 110;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const ty = drop.y - 110;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        el.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${finalScaleX}, ${finalScaleY})`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        el.style.zIndex = drop.zIndex.toString();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const t = timestamp * 0.002 + drop.index;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const breath = Math.sin(t * 2) * 1.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const tl = Math.round(51 + drop.wobbleX * 6 + breath);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const tr = Math.round(49 - drop.wobbleX * 6 - breath);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const br = Math.round(62 * (1 - bottomProximity * 0.22) + drop.wobbleY * 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const bl = Math.round(38 * (1 - bottomProximity * 0.18) - drop.wobbleY * 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const vtl = Math.round(25 + bottomProximity * 12 + drop.wobbleY * 6);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const vtr = Math.round(57 + bottomProximity * 8 - drop.wobbleY * 6);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const vbr = Math.round(43 * (1 - bottomProximity * 0.25) - drop.wobbleX * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const vbl = Math.round(75 * (1 - bottomProximity * 0.2) + drop.wobbleX * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        el.style.borderRadius = `${tl}% ${tr}% ${br}% ${bl}% / ${vtl}% ${vtr}% ${vbr}% ${vbl}%`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 5. Clean up merged droplets from state"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (pendingRemovals.length > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dropletsRef.current = dropletsRef.current.filter((d) => !pendingRemovals.includes(d.id));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
