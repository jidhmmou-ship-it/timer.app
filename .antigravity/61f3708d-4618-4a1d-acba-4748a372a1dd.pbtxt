            }
            lines {
              text: "    if (drop) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      drop.wobbleVelY -= 4;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      drop.wobbleVelX += 3;"
