            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Dissipation: shrink radius and fade opacity smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          sp.currentRadius = sp.initialRadius * Math.pow(1 - sp.life, 0.65);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          sp.currentOpacity = sp.initialOpacity * Math.pow(1 - sp.life, 1.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const splashCircles = splashCircleRefs.current;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const numActiveSplash = splashParticles.length;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < splashCircles.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const circle = splashCircles[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (!circle) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (i < numActiveSplash) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const sp = splashParticles[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          circle.setAttribute(\'cx\', sp.x.toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          circle.setAttribute(\'cy\', sp.y.toFixed(1));"
