            }
            lines {
              text: "                drop.wobbleVelY -= squashPower * 5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                // Radial burst of splash particles on left screen edge impact"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const leftContactX = drop.x - effectiveRadius * 0.78;"
