  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    start_line: 119
    end_line: 149
    content: "    state.wobbleVelY = 0;\n  }, [updateDockCoords]);\n\n  // Dock / Absorb the 1:1 droplet app back into the taskbar\n  const dockApp = useCallback(() => {\n    updateDockCoords();\n    const state = stateRef.current;\n    if (state.status === \'docked\' || state.status === \'docking\') return;\n\n    state.status = \'docking\';\n    setAppStatus(\'docking\');\n    state.isDragging = false;\n    state.transStartTime = performance.now();\n    state.transStartX = state.x;\n    state.transStartY = state.y;\n    state.transTargetX = state.dockX;\n    state.transTargetY = state.dockY;\n    state.vx = 0;\n    state.vy = 0;\n  }, [updateDockCoords]);\n\n  // Main 60-120fps Animation & Physics Loop\n  useEffect(() => {\n    let animId: number;\n\n    const R = 95; // Effective radius for 220px 1:1 window\n    const GRAVITY = 750; // Gentle downward gravity\n    const AIR_RESISTANCE = 0.985; // Subtle air drag\n    const BOUNCE_RESTITUTION_BOTTOM = 0.28; // Calmed recoil: settles softly\n    const BOUNCE_RESTITUTION_WALL = 0.35; // Calmed wall bounce: soft liquid absorption\n    const SPRING_K = 110; // Surface tension spring recovery"
    num_lines: 685
    num_bytes: 24738
    line_range_bytes: 1105
  }
}
