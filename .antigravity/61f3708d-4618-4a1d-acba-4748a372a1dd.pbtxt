            }
            lines {
              text: "      for (let i = 0; i < circles.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const circle = circles[i];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (!circle) continue;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        if (i < numActiveVapor) {"
