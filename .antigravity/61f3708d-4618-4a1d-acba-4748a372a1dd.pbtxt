  search_web {
    query: "\"water drop\" OR \"droplet\" mp3 audio url free cdn OR wikimedia commons"
    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGwS91L1pCxDaGTsGlChZKq5luXl0nM5PTYqt-BRGrpQljH0aH27yOOAy3LsL-hDpIzDv3HeYz5hPy9qawM9uCwEcRlH8TOu8RxSXQMchGgE55v2vr2kIMYWlQCdZ8iVIo-gcAVqAc8uLUMACq4f_c32Q=="
