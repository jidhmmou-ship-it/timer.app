            lines {
              text: "    playRippleSound();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const floaters = dropletsRef.current.filter((d) => d.status === \'floating\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (floaters.length <= 1) return;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
