        target_content: "    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Water Droplet</title>"
        replacement_content: "    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <script>\n      (function() {\n        try {\n          var originalFetch = window.fetch;\n          var currentFetch = originalFetch;\n          Object.defineProperty(window, \'fetch\', {\n            get: function() {\n              return currentFetch;\n            },\n            set: function(val) {\n              currentFetch = val;\n            },\n            configurable: true,\n            enumerable: true\n          });\n        } catch (e) {}\n\n        window.addEventListener(\'error\', function(e) {\n          if (e && (e.filename && e.filename.startsWith(\'chrome-extension://\') || (e.message && e.message.includes(\'fetch of #<Window>\')))) {\n            e.preventDefault();\n            e.stopImmediatePropagation();\n          }\n        }, true);\n      })();\n    </script>\n    <title>Water Droplet</title>"
        start_line: 4
        end_line: 6
      }
