            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // Collision with floor (bottom of site)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        if (state.y >= maxY) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          state.y = maxY;"
