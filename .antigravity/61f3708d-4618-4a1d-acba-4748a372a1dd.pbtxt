              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (!dropB.isDragging) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                dropB.x += nx * overlap;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                dropB.y += ny * overlap;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
