              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const ty = drop.y - 110;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        el.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${finalScaleX}, ${finalScaleY})`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        el.style.zIndex = drop.zIndex.toString();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        el.style.opacity = (drop.status === \'evaporating\' ? drop.opacity : 1).toFixed(3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        el.style.pointerEvents = drop.status === \'evaporating\' ? \'none\' : \'auto\';"
