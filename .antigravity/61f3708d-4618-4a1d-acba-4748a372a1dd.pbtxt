            }
            lines {
              text: "    state.transTargetX = window.innerWidth / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    state.transTargetY = Math.max(160, window.innerHeight * 0.42);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    state.x = state.dockX;"
