  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    start_line: 459
    end_line: 554
    content: "  // Pointer dragging handlers for the 1:1 window\n  const handlePointerDown = (e: React.PointerEvent<HTMLDivElement>) => {\n    const state = stateRef.current;\n    if (state.status !== \'floating\') return;\n\n    state.isDragging = true;\n    state.dragPointerId = e.pointerId;\n    e.currentTarget.setPointerCapture(e.pointerId);\n\n    state.dragOffsetX = e.clientX - state.x;\n    state.dragOffsetY = e.clientY - state.y;\n    state.targetX = e.clientX - state.dragOffsetX;\n    state.targetY = e.clientY - state.dragOffsetY;\n\n    state.history = [{ x: e.clientX, y: e.clientY, time: performance.now() }];\n\n    // Subtle gentle pickup squish\n    state.wobbleVelX += 2;\n    state.wobbleVelY -= 3;\n  };\n\n  const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {\n    const state = stateRef.current;\n    if (!state.isDragging || state.dragPointerId !== e.pointerId) return;\n\n    state.targetX = e.clientX - state.dragOffsetX;\n    state.targetY = e.clientY - state.dragOffsetY;\n\n    const now = performance.now();\n    state.history.push({ x: e.clientX, y: e.clientY, time: now });\n\n    while (state.history.length > 2 && now - state.history[0].time > 100) {\n      state.history.shift();\n    }\n  };\n\n  const handlePointerUp = (e: React.PointerEvent<HTMLDivElement>) => {\n    const state = stateRef.current;\n    if (!state.isDragging || state.dragPointerId !== e.pointerId) return;\n\n    state.isDragging = false;\n    state.dragPointerId = -1;\n\n    try {\n      e.currentTarget.releasePointerCapture(e.pointerId);\n    } catch {\n      // Ignore\n    }\n\n    // Check if dropped near the taskbar: if so, smoothly absorb and dock!\n    const distToDock = Math.hypot(state.x - state.dockX, state.y - state.dockY);\n    if (distToDock < 140) {\n      dockApp();\n      return;\n    }\n\n    // Fling / throw velocity with calm limits\n    const now = performance.now();\n    const history = state.history.filter((h) => now - h.time <= 100);\n\n    if (history.length >= 2) {\n      const oldest = history[0];\n      const newest = history[history.length - 1];\n      const timeDelta = (newest.time - oldest.time) / 1000;\n\n      if (timeDelta > 0.015) {\n        const throwVx = (newest.x - oldest.x) / timeDelta;\n        const throwVy = (newest.y - oldest.y) / timeDelta;\n\n        // Controlled speed cap: throws stay gentle, calm and elegant\n        const maxSpeed = 1600;\n        const speed = Math.hypot(throwVx, throwVy);\n        if (speed > maxSpeed) {\n          state.vx = (throwVx / speed) * maxSpeed;\n          state.vy = (throwVy / speed) * maxSpeed;\n        } else {\n          state.vx = throwVx;\n          state.vy = throwVy;\n        }\n\n        if (speed > 200) {\n          const flingSquash = Math.min(speed * 0.0003, 0.12);\n          state.wobbleVelX += flingSquash * 3;\n          state.wobbleVelY -= flingSquash * 3;\n        }\n      }\n    }\n  };\n\n  // Click inside the 1:1 window to create a water ripple\n  const handleWindowClick = (e: React.MouseEvent<HTMLDivElement>) => {\n    const rect = e.currentTarget.getBoundingClientRect();\n    const rippleX = e.clientX - rect.left;\n    const rippleY = e.clientY - rect.top;\n\n    const newRipple = { id: Date.now(), x: rippleX, y: rippleY };"
    num_lines: 708
