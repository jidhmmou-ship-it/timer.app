              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          cardRef.current.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${finalScaleX}, ${finalScaleY})`;"
